# Copier ce fichier vers .env pour le développement et remplacer les valeurs de démonstration.
# Ne pas utiliser les paramètres de développement tels quels en production.

# Paramètres Django
SECRET_KEY="remplacer-par-une-cle-secrete-unique"
DEBUG=True
ALLOWED_HOSTS="127.0.0.1,localhost,testserver"
CSRF_TRUSTED_ORIGINS="http://localhost:8000,http://127.0.0.1:8000"
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
# En production, définir DEBUG=False, une SECRET_KEY aléatoire, ALLOWED_HOSTS et
# les origines CSRF/CORS exactes en HTTPS. Les redirections HTTPS et cookies sécurisés
# sont alors activés automatiquement et ne peuvent pas être désactivés.
# Générer une clé avec : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Remplacer aussi le mot de passe PostgreSQL de démonstration par un secret robuste.
# N’activer HSTS qu’après avoir confirmé que HTTPS fonctionne sur tout le domaine :
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True seulement si tous les sous-domaines utilisent HTTPS.
# SECURE_HSTS_PRELOAD=True seulement après vérification des critères de préchargement HSTS.
# Si TLS se termine sur un proxy de confiance, configurer l’en-tête réellement défini par ce proxy :
# SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

# Authentification Google (OAuth 2.0)
# Créer un identifiant client Web dans Google Cloud Console, puis autoriser chaque
# origine réellement utilisée dans « Origines JavaScript autorisées » :
# http://127.0.0.1:8000 et http://localhost:8000 en développement,
# puis l’origine HTTPS exacte du site en production (sans chemin final).
GOOGLE_CLIENT_ID="votre-client-id.apps.googleusercontent.com"

# PostgreSQL du docker-compose (DB_HOST=postgres si Django tourne aussi dans Docker)
DB_NAME=jupython
DB_USER=jupython
DB_PASSWORD="remplacer-par-un-mot-de-passe-fort"
DB_HOST=localhost
DB_PORT=5432

# SMTP pour envoyer les liens de réinitialisation du mot de passe en production.
# SMTP Gmail pour envoyer les liens de réinitialisation du mot de passe.
# G?n?re un mot de passe d?application Google apr?s avoir activ? la validation en 2 ?tapes.
# Ne mets pas le mot de passe habituel du compte dans EMAIL_HOST_PASSWORD.
# R?f?rence : https://support.google.com/mail/answer/7104828
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=jupythonccodepro@gmail.com
EMAIL_HOST_PASSWORD="remplacer-par-un-mot-de-passe-d-application-google"
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL="Jupython Academy <jupythonccodepro@gmail.com>"
