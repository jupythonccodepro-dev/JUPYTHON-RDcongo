# Copy to deploy/production.env, replace every placeholder, then chmod 600.
DEBUG=False
SECRET_KEY=replace-with-a-random-Django-secret-key
DOMAIN=academy.example.cd
ALLOWED_HOSTS=academy.example.cd
CSRF_TRUSTED_ORIGINS=https://academy.example.cd
CORS_ALLOWED_ORIGINS=https://academy.example.cd

POSTGRES_DB=jupython
POSTGRES_USER=jupython
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DB_NAME=jupython
DB_USER=jupython
DB_HOST=db
DB_PORT=5432

# Optional Google sign-in client ID.
GOOGLE_CLIENT_ID=

# Gmail SMTP. Use a Google App Password, never the normal account password.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=jupythonccodepro@gmail.com
EMAIL_HOST_PASSWORD=replace-with-a-google-app-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Jupython Academy <jupythonccodepro@gmail.com>
MAINTENANCE_REPORT_EMAIL=
